# Secrets: generated by `make setup`. Only .env.example is tracked.
.env
.env.*.bak
*.pem
*.p12
*.key

# Vexa itself: cloned at a pinned tag by `make setup` and patched from patches/.
vexa/

# Runtime state and output
logs/
.run/
recordings/
*.webm
*.wav
*.m4a

# Python (whisper-server)
whisper-server/.venv/
__pycache__/
*.pyc

# Swift app builds
app/.build/
app/build/
*.crx

# Local tool and editor files
.DS_Store
.claude/settings.local.json
.vscode/
.idea/

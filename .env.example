# vexa-local-mac settings. `make setup` builds .env from Vexa's own
# deploy/compose/.env.example, then applies these values on top.
# "generate" is replaced with a random secret.

# --- Vexa secrets --------------------------------------------------------------
ADMIN_TOKEN=generate
INTERNAL_API_SECRET=generate
VEXA_DISPATCH_SIGNING_KEY=generate
NEXTAUTH_SECRET=generate
VEXA_FLOWS_API_KEY=generate
VEXA_FLOWS_TIMELINE_KEY=generate
DB_PASSWORD=generate
MINIO_SECRET_KEY=generate

# --- Vexa settings -------------------------------------------------------------
# The bot is built locally for Apple Silicon (see scripts/setup.sh).
BROWSER_IMAGE=vexa/vexa-bot:local
DEFAULT_BOT_NAME=Vexa Notetaker
VEXA_UI_URL=http://localhost:13000
RECORDING_ENABLED=false

# --- Transcription: the native Whisper server on this Mac ----------------------
# Containers in Colima reach the Mac's 127.0.0.1 through host.docker.internal.
TRANSCRIPTION_SERVICE_URL=http://host.docker.internal:8083
TRANSCRIPTION_SERVICE_TOKEN=generate
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Whisper server ------------------------------------------------------------
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8083
# Any mlx-community Whisper repo on Hugging Face, e.g.
#   mlx-community/whisper-large-v3-turbo   (default, fast + accurate)
#   mlx-community/whisper-large-v3-mlx     (slower, slightly more accurate)
#   mlx-community/whisper-small-mlx        (light machines)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# --- Colima VM (used when the scripts have to create it) -----------------------
COLIMA_PROFILE=default
COLIMA_CPUS=6
COLIMA_MEMORY=12
COLIMA_DISK=100

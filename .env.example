# Copied to .env by `make setup`. Values set to "generate" get a random secret.

# --- Vexa (Docker on Colima) -------------------------------------------------
# Must be "vexa": bot-manager attaches meeting-bot containers to the
# "${COMPOSE_PROJECT_NAME}_vexa_default" network.
COMPOSE_PROJECT_NAME=vexa
ADMIN_API_TOKEN=generate
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=generate
JWT_SECRET=generate

BOT_IMAGE_NAME=vexa-bot:dev
DEVICE_TYPE=remote
LANGUAGE_DETECTION_SEGMENTS=10
VAD_FILTER_THRESHOLD=0.5
REMOTE_DB=false

# Host ports
API_GATEWAY_HOST_PORT=8056
ADMIN_API_HOST_PORT=8057
TRANSCRIPTION_COLLECTOR_HOST_PORT=8123
POSTGRES_HOST_PORT=5438
DASHBOARD_HOST_PORT=3001
MCP_HOST_PORT=18888
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Recording storage. "local" keeps recordings in a Docker volume.
RECORDING_ENABLED=false
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/recordings
# MinIO settings, only used with STORAGE_BACKEND=minio and --profile minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa-recordings
MINIO_SECURE=false

# Optional: only needed for the voice-agent / TTS feature
OPENAI_API_KEY=

# --- Whisper (native on macOS) -----------------------------------------------
# WhisperLive (in Docker) sends audio here. host.docker.internal reaches the
# Mac's 127.0.0.1 from inside Colima containers.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8083
REMOTE_TRANSCRIBER_URL=http://host.docker.internal:8083/v1/audio/transcriptions
# Shared secret between WhisperLive and the native Whisper server.
REMOTE_TRANSCRIBER_API_KEY=generate
REMOTE_TRANSCRIBER_MODEL=whisper-large-v3-turbo
REMOTE_TRANSCRIBER_TEMPERATURE=0
# Any mlx-community Whisper repo on Hugging Face, e.g.
#   mlx-community/whisper-large-v3-turbo   (default, fast + accurate)
#   mlx-community/whisper-large-v3-mlx     (slower, slightly more accurate)
#   mlx-community/whisper-small-mlx        (light machines)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# --- Colima VM (used when start.sh has to create the VM) ---------------------
COLIMA_PROFILE=default
COLIMA_CPUS=6
COLIMA_MEMORY=12
COLIMA_DISK=100
